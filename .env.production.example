# Copy to .env on the VPS only; never commit the real file.
DOMAIN=plano.synapseengineering.dev
# Generate with: openssl rand -hex 32  (hex keeps the database URL valid)
POSTGRES_PASSWORD=change-me
DATABASE_POOL_SIZE=5
SESSION_TTL_DAYS=30
# Sign-in goes through the Synapse identity service (synapse-auth). The same
# value as PLANO_CLIENT_SECRET in its .env (node deploy/generate-secrets.mjs).
OIDC_CLIENT_SECRET=change-me
# Docker network of the Mailcow stack (docker network ls)
MAILCOW_NETWORK=mailcowdockerized_mailcow-network
