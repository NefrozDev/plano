# Copy to .env on the VPS only; never commit the real file.
DOMAIN=plano.synapseengineering.dev
# Generate with: openssl rand -hex 32  (hex keeps the database URL valid)
POSTGRES_PASSWORD=change-me
DATABASE_POOL_SIZE=5
SESSION_TTL_DAYS=30
# Password recovery e-mails, sent through a Mailcow mailbox (create it in the
# Mailcow UI, e.g. no-reply@synapseengineering.dev). Port 465 is SMTPS.
# Empty SMTP_HOST: no e-mail is sent and recovery cannot complete.
SMTP_HOST=mail.synapseengineering.dev
SMTP_PORT=465
SMTP_USER=no-reply@synapseengineering.dev
SMTP_PASSWORD=change-me
MAIL_FROM=Plano <no-reply@synapseengineering.dev>
# Docker network of the Mailcow stack (docker network ls)
MAILCOW_NETWORK=mailcowdockerized_mailcow-network
