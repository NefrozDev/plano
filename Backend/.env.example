PORT=3000
FRONTEND_URL=http://localhost:4200
DATABASE_URL=postgres://plano:plano@localhost:5432/plano
DATABASE_POOL_SIZE=5
SESSION_TTL_DAYS=30
# The Synapse identity service (synapse-auth) signs people in: run it locally
# (its pages on :4300) or point to the deployed one.
OIDC_ISSUER=http://localhost:4300/oidc
OIDC_CLIENT_ID=plano
OIDC_CLIENT_SECRET=plano-development-secret
